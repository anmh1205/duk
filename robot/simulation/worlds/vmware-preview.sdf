<?xml version="1.0"?>
<!-- Small, local-only rendering test world. No Fuel assets or robot dynamics. -->
<sdf version="1.9">
  <world name="duk_preview">
    <physics name="preview_physics" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.88 0.91 0.95 1</background><shadows>false</shadows></scene>
    <light name="sun" type="directional">
      <pose>0 0 3 0 0 0</pose><cast_shadows>false</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.3 -1</direction>
    </light>
    <model name="ground"><static>true</static><link name="ground_link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        <material><ambient>0.65 0.69 0.73 1</ambient><diffuse>0.65 0.69 0.73 1</diffuse></material>
      </visual>
    </link></model>
  </world>
</sdf>
