<?xml version="1.0"?>
<package format="3">
  <name>duk_description</name>
  <version>0.1.0</version>
  <description>Geometry-derived DUK static preview and fixed-body kinematic bench.</description>
  <maintainer email="maintainers@example.com">DUK contributors</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch_ros</exec_depend>
