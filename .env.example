# DUK development container configuration.
# All values are optional; the repository works with the defaults below.

# ROS distribution used by the development image.
# The environment CI validates Jazzy and Humble on linux/amd64.
ROS_DISTRO=jazzy

# The image's non-root developer identity. Ubuntu's first local user normally
# uses 1000:1000, so these defaults usually match a standard Linux workstation.
# Dev Containers automatically remap the remote user's UID/GID on Linux.
DEV_UID=1000
DEV_GID=1000
